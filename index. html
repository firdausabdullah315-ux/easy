<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EASY MANAGEMENT SERVICE</title><script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>body{font-family:Inter,sans-serif;background:#050A14;color:#E2E8F0}.mono{font-family:'JetBrains Mono',monospace}.border-glow{border:1px solid rgba(56,189,248,0.3)}.bg-grid{background-image:radial-gradient(rgba(56,189,248,0.1) 1px, transparent 1px);background-size:24px 24px}</style>
</head><body class="bg-grid min-h-screen p-3"><div class="max-w-7xl mx-auto">
<div class="flex justify-between items-center border-glow rounded-xl p-4 bg-[#0A1428]/80 mb-6">
<div><h1 class="mono text-xl font-bold"><span class="text-cyan-400">EASY</span> MANAGEMENT SERVICE</h1>
<p class="text-xs text-cyan-400/60 mono" id="locDisplay"></p></div>
<div class="w-8 h-8 rounded-full bg-cyan-500/20 border border-cyan-400 flex items-center justify-center mono text-xs">EMS</div></div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
<div class="border-glow bg-[#0F1D36]/60 rounded-xl p-4"><p class="text-[10px] mono text-cyan-400/60">CLIENTS</p><p class="text-2xl font-bold mono">24</p></div>
<div class="border-glow bg-[#0F1D36]/60 rounded-xl p-4"><p class="text-[10px] mono text-cyan-400/60">PROJECTS</p><p class="text-2xl font-bold mono text-cyan-300">12</p></div>
<div class="border-glow bg-[#0F1D36]/60 rounded-xl p-4"><p class="text-[10px] mono text-cyan-400/60">PRODUCTS</p><p class="text-2xl font-bold mono" id="statProducts">0</p></div>
<div class="border-glow bg-[#0F1D36]/60 rounded-xl p-4"><p class="text-[10px] mono text-cyan-400/60">REVENUE</p><p class="text-2xl font-bold mono text-cyan-300">RM48.2K</p></div></div>
<div class="border-glow bg-[#0F1D36]/60 rounded-xl p-4 mb-6"><div class="flex justify-between mb-4"><h2 class="mono font-bold">SERVICES & PRODUCTS</h2><span class="text-[10px] mono text-emerald-400" id="lastBackup">SECURE</span></div><div id="productGrid" class="grid grid-cols-1 md:grid-cols-3 gap-3"></div></div>
<div class="border-glow bg-[#0A1428]/60 rounded-xl p-3 flex justify-between text-[10px] mono text-slate-400"><span>📍 <span id="locFooter"></span> • Secured v1.3</span><span><a href="admin.html" class="text-cyan-400 underline">Admin + Backup</a> • GitHub Ready</span></div></div>
<script>
function escapeHtml(str){if(!str) return '';return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
function sanitizeInput(str){return escapeHtml(str).trim().substring(0,100);}
const defaultAddr="4-14 - 16 DESA TUN RAZAK, 56000 CHERAS KUALA LUMPUR";
const defaultProducts=[{id:1,name:"Network Setup",price:"RM350",desc:"Router, Switch, AP",icon:"🌐"},{id:2,name:"PC Repair",price:"RM80",desc:"Hardware & Format",icon:"💻"},{id:3,name:"VOIP System",price:"RM500",desc:"IP Phone PABX",icon:"📞"}];
function loadDB(){try{let db=JSON.parse(localStorage.getItem('ems_db_v13')||'{}');if(!db.address)db.address=localStorage.getItem('ems_address')||defaultAddr;if(!db.products)db.products=JSON.parse(localStorage.getItem('ems_products')||JSON.stringify(defaultProducts));if(!db.backupDate)db.backupDate=new Date().toISOString();return db;}catch(e){return{address:defaultAddr,products:defaultProducts,backupDate:new Date().toISOString()}}}
let DB=loadDB();document.getElementById('locDisplay').innerText=DB.address;document.getElementById('locFooter').innerText=DB.address;document.getElementById('statProducts').innerText=DB.products.length;
function renderProducts(){const grid=document.getElementById('productGrid');grid.innerHTML='';DB.products.forEach(p=>{const card=document.createElement('div');card.className="border border-cyan-500/20 rounded-lg p-3 bg-[#0A1428]/80";const icon=document.createElement('span');icon.innerText=p.icon||"📦";const price=document.createElement('span');price.className="text-xs mono text-cyan-400 border border-cyan-400/30 px-2 rounded-full";price.innerText=sanitizeInput(p.price);const header=document.createElement('div');header.className="flex justify-between";header.appendChild(icon);header.appendChild(price);const name=document.createElement('p');name.className="font-semibold text-sm mt-2";name.innerText=sanitizeInput(p.name);const desc=document.createElement('p');desc.className="text-[11px] text-slate-400";desc.innerText=sanitizeInput(p.desc);const btn=document.createElement('button');btn.className="w-full mt-2 bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 mono text-[10px] py-1.5 rounded";btn.innerText="ORDER";card.appendChild(header);card.appendChild(name);card.appendChild(desc);card.appendChild(btn);grid.appendChild(card);});}
renderProducts();document.getElementById('lastBackup').innerText="Secure: "+new Date(DB.backupDate).toLocaleString();
</script></body></html>
